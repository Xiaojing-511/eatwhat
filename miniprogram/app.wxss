page {
  background: #ffffff;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  font-weight: normal;
  text-align: left;
}

button::after {
  border: none;
}
